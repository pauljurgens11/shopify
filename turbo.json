{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "DATABASE_URL", "REDIS_URL", "ANTHROPIC_API_KEY", "VAULT_MASTER_KEY"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["@merchant/db#generate"]
    },
    "build": {
      "dependsOn": ["^build", "@merchant/db#generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "@merchant/db#generate"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["@merchant/db#generate"],
      "outputs": []
    },
    "@merchant/db#generate": {
      "inputs": ["prisma/**"],
      "outputs": ["generated/**"]
    }
  }
}
