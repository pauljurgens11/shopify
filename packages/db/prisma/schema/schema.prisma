// Datasource + generator only. Models live in sibling files, one per domain.
//
// Multi-file schema is a deliberate anti-conflict measure: a single
// schema.prisma would be the hottest merge conflict in a repo worked by 20
// agents. See CLAUDE.md §3.

generator client {
  // No custom `output`: the default location makes the client resolvable as the
  // package `@prisma/client`, which bundlers leave external. Pointing it at a
  // path inside this package causes tsup to inline the CJS runtime, and its
  // dynamic require("fs") then throws at runtime in the ESM bundle.
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
