{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/dist",
      "!**/.turbo",
      "!**/generated",
      "!**/pnpm-lock.yaml",
      "!**/test-results",
      "!**/playwright-report"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "warn",
        "noConsole": {
          "level": "off",
          "options": {
            "allow": ["log"]
          }
        }
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "warn",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "@merchant/db/client": {
                "importNames": ["dbAdmin"],
                "message": "dbAdmin is unscoped \u2014 request handlers use request.db / dbForShop (CLAUDE.md \u00a76). The sanctioned exceptions (signup, platform auth lookup, vault origin lookup, seeds, tests) are allowlisted in this file's overrides; if your use genuinely qualifies, add it there in the same PR and say why."
              },
              "@prisma/client": "Construct no raw Prisma client outside packages/db \u2014 import types and dbForShop via @merchant/db/* so every query stays behind the tenancy boundary."
            }
          }
        }
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/db/**",
        "apps/api/src/plugins/tenancy.ts",
        "apps/api/src/lib/custom-domains.ts",
        "apps/api/src/routes/auth/**",
        "apps/api/src/routes/vault/**",
        "apps/worker/scripts/**",
        "apps/worker/src/jobs/analytics-rollup.ts",
        "apps/api/test/**",
        "**/*.test.ts",
        "e2e/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "json": {
    "formatter": {
      "indentWidth": 2
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
