{
  "name": "merchant",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --filter=!@merchant/e2e",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "pnpm --filter @merchant/db run generate",
    "db:migrate": "pnpm --filter @merchant/db run migrate",
    "db:setup": "pnpm --filter @merchant/db run setup",
    "db:reset": "pnpm --filter @merchant/db run reset",
    "db:query": "bash scripts/db-query.sh",
    "seed": "pnpm --filter @merchant/db run seed",
    "e2e": "pnpm --filter @merchant/e2e run test",
    "verify": "node scripts/check-env-parity.mjs && pnpm lint && pnpm typecheck && pnpm test",
    "setup:git": "bash scripts/setup-git.sh",
    "sync": "bash scripts/sync.sh",
    "stack": "bash scripts/stack.sh",
    "worktree:env": "bash scripts/worktree-env.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "@shopify/polaris>react": "19",
        "@shopify/polaris>react-dom": "19"
      }
    }
  }
}
